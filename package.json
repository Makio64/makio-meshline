{
  "name": "makio-meshline-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter demo build",
    "build:track-maker": "pnpm --filter demo exec vite build --config vite.track-maker.config.js",
    "test": "node --test test/*.test.js",
    "test:types": "tsc --project tsconfig.types.json",
    "bench:v2": "node benchmarks/v2-geometry.mjs",
    "bench:hotpaths": "node benchmarks/meshline-geometry-hotpaths.mjs",
    "bench:surface-topology": "node --expose-gc benchmarks/surface-variable-topology.mjs",
    "bench:bounds": "node benchmarks/meshline-bounds-refresh.mjs",
    "bench:browser": "node benchmarks/browser/run.mjs",
    "preview": "pnpm --filter demo preview",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview",
    "lint": "eslint src/ demo/src/ examples/ scripts/",
    "lint:fix": "eslint src/ demo/src/ examples/ scripts/ --fix",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:compat": "node scripts/verify-compatibility.mjs",
    "verify:compat:canary": "node scripts/verify-compatibility.mjs --dev-canary-only",
    "release:check": "pnpm lint && pnpm test && pnpm test:types && pnpm build && pnpm docs:build && pnpm --filter makio-meshline-vanilla-example build && pnpm --filter makio-meshline-r3f-example build && pnpm --filter makio-meshline-vue-example build && pnpm verify:package && pnpm verify:compat"
  },
  "meshlineCompatibility": {
    "minimum": {
      "three": "0.186.0",
      "types": "0.186.0"
    }
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/three": "0.187.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.12.0",
    "makio-meshline": "workspace:*",
    "three": "0.187.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.16.1"
}
