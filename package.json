{
  "name": "makio-meshline",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter demo build",
    "test": "node --test test/*.test.js",
    "test:types": "tsc --project tsconfig.types.json",
		"bench:v2": "node benchmarks/v2-geometry.mjs",
		"bench:hotpaths": "node benchmarks/meshline-geometry-hotpaths.mjs",
		"bench:surface-topology": "node --expose-gc benchmarks/surface-variable-topology.mjs",
    "preview": "pnpm --filter demo preview",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview",
    "lint": "eslint src/ demo/src/",
    "lint:fix": "eslint src/ demo/src/ --fix",
    "publish:lib": "pnpm --filter ./src publish --access public"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/three": "0.183.1",
    "eslint": "^10.2.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.9.0",
    "three": "0.183.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.2"
}
