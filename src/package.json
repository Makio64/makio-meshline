    "README.md",
    "LICENSE",
    "package.json"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "three": ">=0.180.0"
  },
  "keywords": [
    "three.js",
    "three",
    "webgpu",
    "webgl2",
    "tsl",
    "line",
    "meshline",
    "wide-line",
