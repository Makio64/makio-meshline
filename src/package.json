{
  "name": "makio-meshline",
  "version": "1.4.0",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "description": "TSL-powered wide-line and MeshLine renderer for Three.js with gradients, dashes, textures, shadows, GPU positions, and instancing.",
