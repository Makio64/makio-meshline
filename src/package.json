  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Makio64/makio-meshline.git"
  },
  "bugs": {
    "url": "https://github.com/Makio64/makio-meshline/issues"
  },
  "homepage": "https://meshline.makio.io",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm -w run lint && pnpm -w run test && pnpm -w run test:types && pnpm -w run verify:package"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "three": "0.187.0"
  }
}
