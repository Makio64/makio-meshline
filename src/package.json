    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "MeshLine.js",
    "MeshLineGeometry.js",
    "MeshLineNodeMaterial.js",
    "MeshLinePicker.js",
