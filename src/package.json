  "repository": {
    "type": "git",
    "url": "git+https://github.com/Makio64/makio-meshline.git"
  },
  "bugs": {
    "url": "https://github.com/Makio64/makio-meshline/issues"
  },
  "homepage": "https://meshline.makio.io",
