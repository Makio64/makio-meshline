{
  "name": "makio-meshline",
  "version": "2.0.0",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "description": "TSL-powered wide-line and road/ribbon surface renderer for Three.js with gradients, textures, GPU positions, and instancing.",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./gpu-culling": {
      "types": "./gpu-culling.d.ts",
      "import": "./MeshLineCullingSystem.js"
    },
    "./gpu-path": {
      "types": "./gpu-path.d.ts",
      "import": "./MeshLineGPUPath.js"
    },
    "./positions": {
      "types": "./positions.d.ts",
      "import": "./positions/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "MeshLine.js",
    "MeshLineBillboard.js",
    "MeshLineGeometry.js",
    "MeshLineNodeMaterial.js",
    "MeshLineSurfaceGeometry.js",
    "MeshLineSurfaceNodeMaterial.js",
    "MeshLineCompute.js",
    "MeshLinePicker.js",
    "MeshLinePickerHelper.js",
    "MeshLineCullingSystem.js",
    "MeshLineGPUPath.js",
    "gpu-culling.d.ts",
    "gpu-path.d.ts",
    "positions.d.ts",
    "positions/*.js",
    "README.md",
    "llms-full.txt",
    "LICENSE",
    "package.json"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@types/three": ">=0.186.0",
    "three": ">=0.186.0"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  },
  "keywords": [
    "three.js",
    "three",
    "webgpu",
    "webgl2",
    "tsl",
    "three-tsl",
    "line",
    "meshline",
    "wide-line",
    "polyline",
    "thick-line",
    "ribbon",
    "road",
    "surface",
    "contour",
    "isobar",
    "trail",
    "miter",
    "bevel",
    "gpu-culling",
    "storage-buffer",
    "line-rendering",
    "nodeMaterial",
    "node-material",
    "shader",
    "instanced",
    "instancing",
    "dashed-line",
    "gradient-line",
    "react-three-fiber",
    "r3f",
    "vue",
    "creative-coding",
    "webgpu-renderer"
  ],
  "author": {
    "name": "David Ronai",
